              },
              {
                "name": "startingAfter",
                "value": "",
                "type": "query"
              },
              {
                "name": "endingBefore",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get a list of payments"
        },
        {
          "info": {
            "name": "Create a payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.xfers.io/api/v4/payments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },

        },
        {
          "info": {
            "name": "Get a payment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.xfers.io/api/v4/payments/:paymentId",
            "params": [
              {
                "name": "paymentId",
                "value": "",
                "type": "path"
              }
            ]
